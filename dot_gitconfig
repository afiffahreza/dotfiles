[include]
    path = ~/.gitconfig.local

[core]
    editor = vim
    autocrlf = input
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[commit]
    gpgsign = true

[alias]
    st = status
    co = checkout
    br = branch
    lg = log --oneline --graph --decorate
